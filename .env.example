# ==============================================================================
# GOOGLE CLOUD RUN & ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env or set directly in Google Cloud Run Console / Secret Manager
# ==============================================================================

# OpenRouter AI API Credentials (Jarvis Assistant)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Email Dispatch Configuration (Gmail SMTP or Resend API)
EMAIL_USER=prabuarvind2005@gmail.com
EMAIL_PASSWORD=your_16_character_gmail_app_password
RESEND_API_KEY=your_resend_api_key_here

# Security & Application Settings
SECRET_KEY=generate_a_secure_random_32_character_secret_key_here
PORT=8080
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Rate Limiting Controls
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_HOUR=5
